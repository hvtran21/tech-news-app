NEWS_API_KEY=your_newsapi_key_here
PORT=8000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=newsapp
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Used by node-pg-migrate (migrate:up / migrate:down). Keep in sync with the
# DB_* values above: postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/newsapp
